{
  "name": "tausocial",
  "private": true,
  "version": "1.0.0",
  "description": "TauSocial production monorepo",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @tausocial/web",
    "dev:server": "npm run dev --workspace @tausocial/server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present --",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "secrets:scan": "node tests/security/scan-secrets.mjs",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "smoke": "node tests/load/smoke.mjs",
    "infra:validate": "az bicep build --file infrastructure/main.bicep --stdout > /dev/null && az bicep build-params --file infrastructure/parameters/staging.bicepparam --stdout > /dev/null && az bicep build-params --file infrastructure/parameters/production.bicepparam --stdout > /dev/null && az bicep lint --file infrastructure/main.bicep",
    "openapi": "npm run openapi --workspace @tausocial/server"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
