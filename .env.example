# API runtime environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=<DATABASE_URL_PLACEHOLDER>
DATABASE_SSL=false
PGLITE_DATA_DIR=
# Generate with: openssl rand -hex 32
JWT_SECRET=<JWT_SECRET_MIN_32_CHARS_PLACEHOLDER>
JWT_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CONNECTION_SIMILARITY_THRESHOLD=0.8
MIN_SIGNUP_AGE=13
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local Docker Compose / database
POSTGRES_PASSWORD=<LOCAL_DEV_POSTGRES_PASSWORD>

# Web runtime/build configuration
VITE_API_URL=http://localhost:4000/api/v1
API_UPSTREAM=http://api:4000
